[Desktop Entry]
Version=1.0
Type=Application
Name=Fl-Moe
GenericName=Music Player
GenericName[zh_CN]=音乐播放器
Comment=A native Flutter MoeKoe music client
Comment[zh_CN]=使用 Flutter 实现的原生萌音客户端
Terminal=false
